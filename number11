print("Введите расстояние (км):")
d = float(input())
print("Введите скорость (км/ч):")
v = float(input())
print("Введите расход топлива (л/100 км):")
c = float(input())

t = d / v
f = (c / 100) * d

print(f"Маршрут: {d} км, скорость {v} км/ч")
print(f"Время в пути: {t:.2f} часов")
print(f"Расход топлива: {c} л/100 км")
print(f"Общий расход: {f:.2f} литров")
